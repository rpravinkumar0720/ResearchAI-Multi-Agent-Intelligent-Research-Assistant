# =============================================================================
# ResearchAI – Multi-Agent Intelligent Research Assistant
# Copy this file to .env and add your API key(s).
# =============================================================================

# LLM Provider: "gemini" or "openai"
LLM_PROVIDER=gemini

# Google Gemini API Key (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini/gemini-2.5-flash

# OpenAI API Key (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Tavily Search API Key (https://tavily.com/)
# If not set, DuckDuckGo Search is used automatically (no key required).
TAVILY_API_KEY=

# Search & Report Defaults
DEFAULT_NUM_SOURCES=5
DEFAULT_DEPTH=Intermediate
OUTPUT_DIR=outputs
